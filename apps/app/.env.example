# Copy to .env.local and fill in values.
# Required for local development (see PRE_PR_CHECKLIST.md).

# Cross-origin logout propagation (dev only): AMRAP logout URL to clear session there.
# Dev: http://localhost:5177/amrap/logout. Leave unset in production (same-origin).
# PUBLIC_AMRAP_LOGOUT_URL=http://localhost:5177/amrap/logout

# When AMRAP is deployed at a custom domain (e.g. amrapwithfriends.com), set this so HUD and app launcher links open there.
# Leave unset when AMRAP is same-origin (e.g. example.com/amrap).
# PUBLIC_AMRAP_BASE_URL=https://amrapwithfriends.com

# Universal Activity Hub base URL (e.g. https://hub.example.com). Used by app registry for schedule handoff and launcher links.
# Dev: http://localhost:5180 (or your hub dev port). Leave unset if hub is same-origin.
# PUBLIC_UNIVERSAL_ACTIVITY_HUB_URL=http://localhost:5180

# Supabase (required) - HIIT Workout Timer project (same as AMRAP auth).
# Use PUBLIC_* here, OR set VITE_SUPABASE_* in monorepo root .env (shared with AMRAP).
# URL must be https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Optional: for cross-subdomain auth (Blueprint §9). Set to .yourdomain.com so sb-access-token
# is readable by app.yourdomain.com, yourdomain.com, etc. Leave unset for same-origin or localhost.
# Roster invites + verify: see docs/AUTH_ENV_AND_REDIRECTS.md#roster-invites-email-verification-and-redirect-alignment
# PUBLIC_AUTH_COOKIE_DOMAIN=.hiitworkouttimer.com
# SUPABASE_SERVICE_ROLE_KEY=  # Required for server/API. Get from Dashboard → Settings → API → service_role.
# Optional: HMAC pepper for stable pseudonym IDs in future admin user drill-through (see docs/ADMIN_ANALYTICS.md §Scalability P6).
# ADMIN_ANALYTICS_PSEUDO_PEPPER=
# SUPABASE_ACCESS_TOKEN=     # Optional: for Supabase CLI (link); copy to .env.local
# SUPABASE_DB_PASSWORD=      # Required for supabase db push. Get from Dashboard → Project Settings → Database (reset if needed)

# App URL (hub origin: Mission Control, /api/*, roster invite links & Auth redirectTo). Default: https://app.aiworkoutgenerator.com
# Production on hiitworkouttimer.com: set to your real hub URL. See docs/AUTH_ENV_AND_REDIRECTS.md#roster-invites-email-verification-and-redirect-alignment
# PUBLIC_APP_URL=

# Stripe payment links — HIIT Ecosystem tiers (preferred). Legacy names still work as fallbacks.
# Athlete $9.99 (falls back to PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM; prod default checkout if unset)
# PUBLIC_STRIPE_PAYMENT_LINK_ATHLETE=
# Host $24.99 (falls back to PUBLIC_STRIPE_PAYMENT_LINK_PRO)
# PUBLIC_STRIPE_PAYMENT_LINK_HOST=
# Pro trainer $49.99+ (falls back to PUBLIC_STRIPE_PAYMENT_LINK_ELITE)
# PUBLIC_STRIPE_PAYMENT_LINK_PRO_TRAINER=
# Studio from $199.99 (falls back to COACH_PRO then COACH)
# PUBLIC_STRIPE_PAYMENT_LINK_STUDIO=
# Legacy (optional; used when new tier-specific vars are unset)
# PUBLIC_STRIPE_PAYMENT_LINK_PREMIUM=
# PUBLIC_STRIPE_PAYMENT_LINK_PRO=
# PUBLIC_STRIPE_PAYMENT_LINK_ELITE=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH=
# PUBLIC_STRIPE_PAYMENT_LINK_COACH_PRO=

# Stripe server keys (webhooks). Server runtime only — POST /api/stripe/webhook reads process.env; not Vite import.meta.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: Dashboard endpoint secret, or `whsec_...` from `stripe listen` locally.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Alias (same value as above if you prefer this name):
# STRIPE_SIGNING_SECRET=whsec_...

# Optional: for specific features
# GEMINI_API_KEY=           # Deep dive generation, Veo video generation, paste-workout parse (fallback)
# PARSE_PASTED_WORKOUT_CACHE=1  # Optional: in-memory cache for parse-pasted-workout (TTL 10min, max 500 entries)
# RUNWAYML_API_SECRET=      # Admin exercise video generation (Runway ML, Generate with Runway)
# GOOGLE_PROJECT_ID=        # Vertex AI for paste-workout parse, generate-workout-chain; or use GEMINI_API_KEY
# GOOGLE_APPLICATION_CREDENTIALS_JSON=  # Single-line raw JSON ({"type":"service_account",...}) OR base64 of that JSON (auto-detected in dev)
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=  # base64(utf8 service account JSON); reliable on Vercel

# Firebase Hosting / scripts/set-env.sh (optional; for Firebase App Hosting build)
# Get from Firebase Console → Project settings → General / Your apps. Do not commit real values.
# PUBLIC_FIREBASE_API_KEY=
# PUBLIC_FIREBASE_AUTH_DOMAIN=
# PUBLIC_FIREBASE_PROJECT_ID=
# PUBLIC_FIREBASE_STORAGE_BUCKET=
# PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# PUBLIC_FIREBASE_APP_ID=
# PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=   # reCAPTCHA Enterprise (Console → APIs)
# PUBLIC_GEMINI_API_KEY=                 # If using client-side Gemini (prefer server-side GEMINI_API_KEY)

# --- Vercel (production) ---
# In Vercel: Project → Settings → Environment Variables. Add to EACH project (Root, App):
#   SUPABASE_URL            = https://<project-ref>.supabase.co  (or VITE_SUPABASE_URL / PUBLIC_SUPABASE_URL)
#   SUPABASE_ANON_KEY       = anon JWT (Dashboard → API)         (or VITE_ / PUBLIC_ variants)
#   SUPABASE_SERVICE_ROLE_KEY = service_role JWT — keep secret, server-only.
#   GEMINI_API_KEY          = (required for Visualization Lab / exercise image generation; 503 if missing)
# See docs/SUPABASE_ENV.md. Apply to Production (and Preview if needed).
