# AMRAP With Friends: Supabase (client-safe keys only)
# Copy to .env or .env.local and set values. Never commit .env or .env.local.
# Use only anon/public key here; service_role and DB password are for server-side only.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path: /amrap (default, for merged deploy at example.com/amrap) or / for custom domain (e.g. amrapwithfriends.com)
# VITE_AMRAP_BASE=/

# After login/create account, redirect to Account page (programs app).
# Local dev: http://localhost:3006/account (programs and amrap on different ports)
# Production (same-origin): use relative path /account
# Custom domain (amrapwithfriends.com): use full URL, e.g. https://app.hiitworkouttimer.com/account
VITE_ACCOUNT_REDIRECT_URL=http://localhost:3006/account

# Fallback if VITE_ACCOUNT_REDIRECT_URL not set. Must point to account page, NOT ?hud=1.
# Also used for "View in History" after workout (finished state).
# Custom domain: set to same as VITE_ACCOUNT_REDIRECT_URL (e.g. https://app.hiitworkouttimer.com/account)
# VITE_HUD_REDIRECT_URL=/account

# Agora RTC token API base URL. Only needed when AMRAP is on a different origin (e.g. amrapwithfriends.com).
# Set to the app/accounts domain that serves /api/agora-token (e.g. https://interval-timers-accounts.vercel.app).
# Leave unset when AMRAP is served under same origin (e.g. example.com/amrap).
# VITE_AGORA_TOKEN_BASE_URL=https://interval-timers-accounts.vercel.app

# Recovery PWA base URL for desktop-to-phone QR flow. When unset, uses window.location.origin + '/recovery/'.
# Local dev (recovery runs on 5188): http://localhost:5188/recovery/
# VITE_RECOVERY_PWA_URL=http://localhost:5188/recovery/
