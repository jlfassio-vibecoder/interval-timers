# Copy to `.env.local` and adjust. Do not commit real secrets.
# Values should match `apps/app/.env.local` for the same Supabase project.

# Optional: base URL of the main Astro app (parse API lives there).
# Leave unset in local dev so requests use `/api/...` and Vite proxies to localhost:3006.
# Set for production preview, e.g. VITE_APP_ORIGIN=https://your-app.example.com
# VITE_APP_ORIGIN=

# Same Supabase project as apps/app — for future Training Log / auth in the hub.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
